{
  "name": "n8n-nodes-context-dev",
  "version": "3.0.0",
  "description": "n8n community node for Context.dev API \u2014 brand intelligence, web scraping, AI extraction, monitoring, batch, and web databases",
  "license": "MIT",
  "homepage": "https://github.com/context-dot-dev/n8n-integration#readme",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Yahia Bakour",
    "email": "yahia@context.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/context-dot-dev/n8n-integration.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run lint && npm run build",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test:live": "node tests/live/run-live.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ContextdevApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ContextDev/ContextDev.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
